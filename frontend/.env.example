# =============================================================================
#  HealthLens — Frontend Environment Variables  (Vite)
#  Copy this file to `.env` and fill in the values before running the dev server.
#  All variables MUST be prefixed with VITE_ to be exposed to the browser bundle.
#  Never commit `.env` to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------

# Base URL for the backend REST API (no trailing slash).
# Development:  http://localhost:4000/api
# Production:   https://your-backend-domain.com/api
VITE_API_BASE_URL="http://localhost:4000/api"

# -----------------------------------------------------------------------------
# Mock mode
# -----------------------------------------------------------------------------

# Set to "false" to hit the real backend API.
# Set to "true" (or omit entirely) to use the built-in mock data — useful for
# UI-only development when the backend is not running.
VITE_USE_MOCKS="false"

