{
  "name": "healthlens-insight-worker",
  "version": "1.0.0",
  "description": "Consumes vitals.logged events, runs trend analysis + rules, calls Gemini, stores alerts/summaries",
  "main": "src/consumer.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:sync": "node scripts/sync-schema.js && prisma generate",
    "seed": "tsx src/scripts/seed.ts",
    "publish:event": "tsx src/scripts/publishEvent.ts",
    "test:summary": "tsx src/scripts/runWeeklySummary.ts"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.1",
    "kafkajs": "^2.2.4",
    "node-cron": "^4.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
