# =============================================================================
#  HealthLens — Backend Environment Variables
#  Copy this file to `.env` and fill in the values before running the server.
#  Never commit `.env` to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Prisma / Supabase Postgres)
# -----------------------------------------------------------------------------

# Pooled connection string — used by the API server at runtime.
# In Supabase: Settings → Database → Connection string → "Transaction" mode (port 6543)
# Append ?pgbouncer=true&connection_limit=1 for PgBouncer compatibility.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct (non-pooled) connection — used only for Prisma migrations & introspection.
# In Supabase: Settings → Database → Connection string → "Session" mode (port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Supabase Auth
# -----------------------------------------------------------------------------

# Your Supabase project URL.
# In Supabase: Settings → API → Project URL
SUPABASE_URL="https://<project-ref>.supabase.co"

# Anon / public key — safe to use in server-side requests that act as "unauthenticated".
# In Supabase: Settings → API → Project API keys → anon (public)
SUPABASE_ANON_KEY="eyJ..."

# Service-role key — has full database access, bypasses RLS.
# Required for the Admin API (creating users with email_confirm=true, etc.).
# In Supabase: Settings → API → Project API keys → service_role (secret)
# ⚠️  Keep this secret — never expose it on the client side.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# JWT secret used to verify Supabase-issued tokens locally (optional — the middleware
# validates via the Supabase Auth REST API instead, but kept for reference/fallback).
# In Supabase: Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Port the Express server listens on.
PORT=4000

# Legacy / fallback JWT secret (used if SUPABASE_JWT_SECRET is absent).
# In production this should be a long random string — it is NOT used for login,
# only as a last-resort fallback in config.ts.
JWT_SECRET="healthlens-dev-secret-change-in-production"

# -----------------------------------------------------------------------------
# Kafka (optional — only needed when the vitals streaming pipeline is active)
# -----------------------------------------------------------------------------

# Kafka broker address.  Leave as default for local Docker Compose setup.
KAFKA_BROKER="localhost:9092"

